{
  "compilerOptions": {
    /* 21st.dev / shadcn bilesenleri "@/..." ile import eder; takma ad olmadan
       her dosyada yolu elle duzeltmek gerekirdi. vite.config.ts'teki resolve
       alias'i ile AYNI kalmali, yoksa tsc gecer ama build patlar.
       `baseUrl` YOK: TS 6'da deprecate (TS5101) ve gereksiz — `paths`
       tsconfig'in kendi konumuna gore cozuluyor. */
    "paths": { "@/*": ["./src/*"] },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
