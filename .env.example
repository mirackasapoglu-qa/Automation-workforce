# Aktif ortam — test | staging | prod | local
HOMEE_ENV=test

# Ortam URL'leri
BASE_URL_TEST=https://redesign-prod.test.tepehome.com.tr
BASE_URL_STAGING=
BASE_URL_PROD=
BASE_URL_LOCAL=http://localhost:3000

# "Geçici Erişim" kapısı (Machinarium gate) — test ortamı bunun arkasında
GATE_USER=admin
GATE_PASSWORD=password123

# Üye (mağaza) hesabı
TEST_EMAIL=
TEST_PASSWORD=

# Sipariş TAMAMLAYAN testleri açmak için "1". Default kapalı: checkout ödeme adımına kadar gider.
ALLOW_HOMEE_ORDERS=0

# Timeout / hız
TEST_TIMEOUT=45000
SLOWMO=0

# ---- AI (tek tık üretim: senaryo · perf yorumu · test case) ----
# Sunucuda TEK anahtar yeter; yerelde boş bırakılırsa Claude Code CLI kullanılır,
# o da yoksa "istem üret + yapıştır" yolu çalışır. Sıra: anahtar > CLI > elle.
ANTHROPIC_API_KEY=
# İsteğe bağlı: model (varsayılan claude-opus-5), çaba (low|medium|high|xhigh|max),
# günlük tavan USD (aşınca 429), eşzamanlı çağrı (2), zaman aşımı ms (180000).
AI_MODEL=
AI_EFFORT=
AI_DAILY_USD=
AI_MAX_CONCURRENCY=
AI_TIMEOUT_MS=
# Sırayı zorlamak için: api | cli | manual (varsayılan auto)
AI_PROVIDER=

# ---- Panel (lokal + docker) ----
# Sabit token: docker yeniden başlayınca eski sekmedeki token 403 yemesin (32 hex).
PANEL_TOKEN=
# Sunucuda panelin domain'i (virgülle birden fazla): https://panel.example
PANEL_ORIGIN=
# Docker'da cihaz köprüsü yok; yoklama yapılmasın.
MOBAI_BRIDGE=off
# arm64 sunucuda gerçek Chrome yok: chromium
PW_CHANNEL=

# ---- Connector kimlikleri (sunucuda tek yol env; yerelde ~/.<servis>-credentials de olur)
JIRA_EMAIL=
JIRA_TOKEN=
FIGMA_TOKEN=
